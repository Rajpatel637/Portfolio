# Portfolio Website Environment Configuration

# Email Service (EmailJS)
REACT_APP_EMAILJS_SERVICE_ID=your_service_id_here
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id_here
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here

# Contact Information
REACT_APP_EMAIL=your.email@example.com
REACT_APP_PHONE=+1 (555) 123-4567
REACT_APP_LOCATION=San Francisco, CA

# Social Media Links
REACT_APP_LINKEDIN_URL=https://linkedin.com/in/yourprofile
REACT_APP_GITHUB_URL=https://github.com/yourusername
REACT_APP_TWITTER_URL=https://twitter.com/yourusername

# Performance Settings
REACT_APP_PARTICLE_COUNT=5000
REACT_APP_MAX_FPS=60
REACT_APP_ENABLE_3D=true
REACT_APP_ENABLE_ANIMATIONS=true

# Feature Flags
REACT_APP_CONTACT_FORM=true
REACT_APP_ANALYTICS=false
REACT_APP_ERROR_REPORTING=true
REACT_APP_PERF_MONITORING=false

# Development Settings
REACT_APP_DEBUG=false
REACT_APP_SKIP_ANIMATIONS=false
REACT_APP_HIGH_CONTRAST=false

# Optional: Custom branding
REACT_APP_SITE_TITLE=Your Name - Full Stack Developer
REACT_APP_SITE_DESCRIPTION=Modern portfolio showcasing full-stack development skills